---
import Base from "../layouts/Base.astro";
import SocialIcon from "../components/SocialIcon.astro";

const profile = {
  name: "Marco Sanchotene",
  bio: "Software Developer in Test building practical developer tooling, quality pipelines, and automation with a product mindset.",
};

const socials = [
  { name: "github" as const, label: "GitHub", url: "https://github.com/marcosanchotene" },
  { name: "linkedin" as const, label: "LinkedIn", url: "https://www.linkedin.com/in/marco-sanchotene" },
  { name: "stackoverflow" as const, label: "Stack Overflow", url: "https://stackoverflow.com/users/5489111/marco-s" },
  { name: "buymeacoffee" as const, label: "Buy Me a Coffee", url: "https://www.buymeacoffee.com/m.sanchotene" },
];
---

<Base lang="en" page="portfolio" title="Portfolio — Marco Sanchotene" description={profile.bio}>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute -right-24 -top-24 flex h-[280px] w-[280px] items-center justify-center rounded-full border border-line sm:-right-32 sm:-top-32 sm:h-[380px] sm:w-[380px]"
      aria-hidden="true"
    >
      <div class="h-6 w-6 rounded-full bg-line sm:h-7 sm:w-7"></div>
    </div>

    <main class="relative mx-auto flex max-w-2xl flex-col items-center gap-5 px-6 py-24 text-center sm:py-32">
      <img
        src="/images/profile.png"
        alt={profile.name}
        width="480"
        height="464"
        class="h-40 w-40 rounded-full border border-line object-cover sm:h-44 sm:w-44"
      />

      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{profile.name}</h1>

      <p class="max-w-lg text-lg leading-relaxed text-muted">{profile.bio}</p>

      <ul class="mt-1 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        {socials.map((social) => (
          <li>
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-fg"
            >
              <SocialIcon name={social.name} />
              <span>{social.label}</span>
            </a>
          </li>
        ))}
      </ul>

      <a
        href="/portfolio/projects"
        class="mt-3 border-b border-fg pb-[3px] text-sm font-medium transition-colors hover:border-muted hover:text-muted"
      >
        View projects &rarr;
      </a>
    </main>
  </section>
</Base>
